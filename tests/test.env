# Valeurs FACTICES pour tests/run-docker.sh (--env-file) : elles alimentent l'interpolation
# ${DISCORD_CLIENT_ID} etc. de docker-compose.yml, comme le ferait le .env de production.
DISCORD_CLIENT_ID=fake-discord-id
DISCORD_CLIENT_SECRET=fake-discord-secret
DISCORD_CLIENT_REDIRECT=http://127.0.0.1:3000/?service=discord
TWITCH_CLIENT_ID=fake-twitch-id
TWITCH_CLIENT_SECRET=fake-twitch-secret
TWITCH_CLIENT_REDIRECT=http://127.0.0.1:3000/?service=twitch
