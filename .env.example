# Copier ce fichier en .env (cp .env.example .env) puis le remplir. Ne jamais le commiter.

# Secret de signature des jetons de session (longue chaîne aléatoire)
JWT_SECRET=

# Compte administrateur créé par `node prisma/seed.js`
ADMIN_NAME=
# En clair : prisma/seed.js le hache avant de l'écrire en base.
ADMIN_PASSWORD=

# Connexion Discord (https://discord.com/developers/applications)
# docker-compose.yml les recopie vers NUXT_PUBLIC_DISCORD_CLIENT_ID,
# NUXT_DISCORD_CLIENT_SECRET et NUXT_PUBLIC_DISCORD_CLIENT_REDIRECT.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Doit être déclarée à l'identique dans l'application Discord
DISCORD_CLIENT_REDIRECT=https://milestone.unionrolistes.fr/?service=discord

# Connexion Twitch (https://dev.twitch.tv/console/apps)
# Recopiées vers NUXT_PUBLIC_TWITCH_CLIENT_ID, NUXT_TWITCH_CLIENT_SECRET
# et NUXT_PUBLIC_TWITCH_CLIENT_REDIRECT.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Doit être déclarée à l'identique dans l'application Twitch
TWITCH_CLIENT_REDIRECT=https://milestone.unionrolistes.fr/?service=twitch
